# Local: defaults work with `anvil` + `npm run dev:oracle`.
# Vercel: set these in Project → Settings → Environment Variables.
VITE_RPC_URL=http://127.0.0.1:8545
VITE_ORACLE_URL=http://127.0.0.1:3001
# VITE_CONTRACT_ADDRESS=      # defaults to the address the oracle reports at /health
# VITE_CHAIN_NAME=Base Sepolia
# VITE_EXPLORER_URL=https://sepolia.basescan.org
# VITE_DEPLOY_BLOCK=          # block the contract was deployed in (speeds up event reads)
