{
  "name": "ai-settlement-oracle",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "oracle",
    "demo"
  ],
  "scripts": {
    "chain": "anvil",
    "build:contracts": "cd contracts && forge build",
    "test:contracts": "cd contracts && forge test -vv",
    "oracle": "npm run dev --workspace=oracle",
    "demo": "npm run dev --workspace=demo",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "setup": "npm install && cd contracts && forge build && cd .. && node scripts/export-abi.mjs",
    "preview-sources": "npm run preview-sources --workspace=oracle --"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
