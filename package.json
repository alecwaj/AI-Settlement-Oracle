{
  "name": "ai-settlement-oracle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "oracle",
    "demo"
  ],
  "scripts": {
    "build:contracts": "cd contracts && forge build && cd .. && node scripts/export-abi.mjs",
    "demo:deploy": "tsx scripts/deploy.ts --network local",
    "demo:seed": "tsx scripts/seed.ts --network local",
    "demo:warp": "tsx scripts/warp.ts",
    "dev:oracle": "npm run dev -w oracle",
    "dev:demo": "npm run dev -w demo",
    "test": "cd contracts && forge test && cd .. && npm test -w oracle",
    "testnet:deploy": "tsx scripts/deploy.ts --network base-sepolia",
    "testnet:seed": "tsx scripts/seed.ts --network base-sepolia"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "viem": "^2.43.3",
    "dotenv": "^16.3.1"
  }
}
