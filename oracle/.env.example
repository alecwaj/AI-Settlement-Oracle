# Local development. Copy to oracle/.env
# --- TEE ---
# dstack: real TDX CVM (socket at /var/run/dstack.sock) or the Phala simulator (set DSTACK_SIMULATOR_ENDPOINT)
# dev:    plain private key, NO attestation — local only
TEE_MODE=dev
ORACLE_DEV_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d  # anvil account #1
# DSTACK_SIMULATOR_ENDPOINT=

# --- LLM ---
# confidential: open-weight model inside Confidential AI's TDX + confidential-GPU enclaves (verifiable)
# anthropic:    Claude via Anthropic's API (strong, but inference is NOT hardware-attested)
# mock:         offline dev only (refused inside a real TEE)
LLM_MODE=confidential
CONFIDENTIAL_API_KEY=
CONFIDENTIAL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# Attested path: run TEErminator locally (see BUILD_GUIDE) and keep the default base URL + set TEERMINATOR_BIN.
# Quick unattested smoke test: CONFIDENTIAL_BASE_URL=https://api.confidential.ai/v1
CONFIDENTIAL_BASE_URL=http://127.0.0.1:8080/v1
# TEERMINATOR_BIN=/usr/local/bin/teerminator
REQUIRE_ATTESTED_INFERENCE=false
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Chain ---
RPC_URL=http://127.0.0.1:8545
# CONTRACT_ADDRESS=         # defaults to ../deployments/local.json written by `npm run demo:deploy`
AUTO_SUBMIT=true
WATCH_INTERVAL_MS=5000
PORT=3001
DATA_DIR=./data
