# Required: the oracle will not resolve without a model.
ANTHROPIC_API_KEY=

# Optional model settings
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
# "default" enables server-side refusal fallback; "off" disables it.
ANTHROPIC_FALLBACKS=default

# The Guardian Open Platform key (free at https://open-platform.theguardian.com/access/).
# Defaults to the public, rate-limited "test" key.
GUARDIAN_API_KEY=

# Chain. With a local Anvil chain the contract is deployed and the market registered automatically.
RPC_URL=http://127.0.0.1:8545
# Set to use an existing deployment (required on any non-local chain).
CONTRACT_ADDRESS=
# RPC URL the browser should use for independent verification (defaults to RPC_URL).
PUBLIC_RPC_URL=

# Keys default to Anvil's well-known dev accounts #0 (deployer/relayer) and #1 (oracle signer).
# Never use those defaults on a real network.
DEPLOYER_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=

# Re-run a delayed market automatically when its on-chain delay ends (max three attempts in total
# before the contract pauses the market). Each retry is a model call. Set to false to retry by hand.
AUTO_RETRY=true

# Seconds a delayed market must wait before the next attempt (only used when deploying).
RETRY_DELAY_SECONDS=300

# Evidence limits
MAX_EVIDENCE=20
MAX_CHARS_PER_SOURCE=6000
HTTP_TIMEOUT_MS=20000
PORT=3001
