{
  "name": "oracle",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "verify": "tsx --env-file-if-exists=.env src/cli/verify.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "manual-resolve": "tsx --env-file-if-exists=.env src/cli/manual-resolve.ts",
    "preview-sources": "tsx --env-file-if-exists=.env src/cli/preview-sources.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@oracle/shared": "*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
